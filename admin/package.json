{
  "name": "backend3-admin",
  "version": "0.0.0",
  "description": "The backend3 admin UI: a Hungarian-only ra-core and shadcn-admin-kit single-page app served by backend3 at /admin.",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "licenses": "node scripts/check-licenses.mjs",
    "e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,js}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mjs,js}\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.105.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "diacritic": "^0.0.2",
    "inflection": "^3.0.2",
    "lodash": "^4.18.1",
    "lucide-react": "^1.63.0",
    "next-themes": "^0.4.6",
    "query-string": "^10.0.0",
    "ra-core": "^5.15.5",
    "ra-i18n-polyglot": "^5.15.5",
    "ra-language-english": "^5.15.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-dropzone": "^20.1.4",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^7.91.0",
    "react-router": "^7.18.5",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/estree-jsx": "^1.0.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24",
