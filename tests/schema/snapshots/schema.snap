---
source: tests/schema/snapshot.rs
description: "The schema that the migrations create (ADR 0009), read from pg_catalog by tests/schema. A migration updates this file in its own PR."
---
extension unaccent

collation hu_icu: provider icu, locale hu, deterministic

table users
column users.created_at: timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP
column users.updated_at: timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP
column users.id: bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY
column users.pid: uuid NOT NULL
column users.email: text
column users.name: text NOT NULL
column users.password_hash: text
column users.must_change_password: boolean NOT NULL DEFAULT false
column users.temp_password_expires_at: timestamp with time zone
column users.token_version: integer NOT NULL DEFAULT 0
column users.active: boolean NOT NULL DEFAULT true
column users.last_login_at: timestamp with time zone
column users.totp_secret_encrypted: bytea
column users.totp_enabled_at: timestamp with time zone
column users.totp_last_step: bigint
column users.anonymised_at: timestamp with time zone
column users.created_by: bigint
column users.updated_by: bigint
column users.deleted_at: timestamp with time zone
column users.deleted_by: bigint
constraint users.users_anonymised_shape: CHECK (((anonymised_at IS NULL) OR ((email IS NULL) AND (password_hash IS NULL) AND (totp_secret_encrypted IS NULL) AND (NOT active) AND (deleted_at IS NOT NULL))))
constraint users.users_created_by_fkey: FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE RESTRICT
constraint users.users_deleted_by_fkey: FOREIGN KEY (deleted_by) REFERENCES users(id) ON DELETE RESTRICT
constraint users.users_email_present: CHECK (((email IS NOT NULL) OR (anonymised_at IS NOT NULL)))
constraint users.users_pid_key: UNIQUE (pid)
constraint users.users_pkey: PRIMARY KEY (id)
constraint users.users_updated_by_fkey: FOREIGN KEY (updated_by) REFERENCES users(id) ON DELETE RESTRICT
index users.users_created_by_idx: CREATE INDEX users_created_by_idx ON public.users USING btree (created_by)
index users.users_deleted_by_idx: CREATE INDEX users_deleted_by_idx ON public.users USING btree (deleted_by)
index users.users_lower_email_key: CREATE UNIQUE INDEX users_lower_email_key ON public.users USING btree (lower(email))
index users.users_pid_key: CREATE UNIQUE INDEX users_pid_key ON public.users USING btree (pid)
index users.users_pkey: CREATE UNIQUE INDEX users_pkey ON public.users USING btree (id)
index users.users_updated_by_idx: CREATE INDEX users_updated_by_idx ON public.users USING btree (updated_by)
