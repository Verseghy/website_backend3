---
source: tests/schema/snapshot.rs
description: "The schema that the migrations create (ADR 0009), read from pg_catalog by tests/schema. A migration updates this file in its own PR."
---
extension unaccent

collation hu_icu: provider icu, locale hu, deterministic

table activity_log
column activity_log.id: bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY
column activity_log.occurred_at: timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP
column activity_log.actor_id: bigint
column activity_log.actor_kind: text NOT NULL
column activity_log.action: text NOT NULL
column activity_log.entity_type: text
column activity_log.entity_id: bigint
column activity_log.revision_id: bigint
column activity_log.label: text
column activity_log.details: jsonb
column activity_log.request_id: text
column activity_log.ip: inet
constraint activity_log.activity_log_action_known: CHECK ((action = ANY (ARRAY['create'::text, 'update'::text, 'revert'::text, 'delete'::text, 'restore'::text, 'purge'::text, 'publish'::text, 'unpublish'::text, 'reorder'::text, 'preview_link_regenerated'::text, 'import'::text, 'login'::text, 'login_failed'::text, 'logout'::text, 'password_changed'::text, 'reset_link_issued'::text, 'temporary_password_issued'::text, 'totp_enabled'::text, 'totp_disabled'::text, 'totp_reset'::text, 'recovery_code_used'::text, 'recovery_codes_regenerated'::text, 'account_unlocked'::text, 'user_activated'::text, 'user_deactivated'::text, 'roles_changed'::text, 'grants_changed'::text, 'media_upload'::text, 'media_rename'::text, 'media_move'::text, 'media_delete'::text, 'media_restore'::text, 'media_purge'::text])))
constraint activity_log.activity_log_actor_id_fkey: FOREIGN KEY (actor_id) REFERENCES users(id) ON DELETE RESTRICT
constraint activity_log.activity_log_actor_kind_known: CHECK ((actor_kind = ANY (ARRAY['user'::text, 'system'::text, 'import'::text])))
constraint activity_log.activity_log_actor_shape: CHECK (((actor_kind = 'user'::text) = (actor_id IS NOT NULL)))
constraint activity_log.activity_log_details_object: CHECK ((jsonb_typeof(details) = 'object'::text))
constraint activity_log.activity_log_entity_shape: CHECK (((entity_id IS NULL) OR (entity_type IS NOT NULL)))
constraint activity_log.activity_log_ip_account_only: CHECK (((ip IS NULL) OR (action = ANY (ARRAY['login'::text, 'login_failed'::text, 'logout'::text, 'password_changed'::text, 'reset_link_issued'::text, 'temporary_password_issued'::text, 'totp_enabled'::text, 'totp_disabled'::text, 'totp_reset'::text, 'recovery_code_used'::text, 'recovery_codes_regenerated'::text, 'account_unlocked'::text, 'user_activated'::text, 'user_deactivated'::text, 'roles_changed'::text, 'grants_changed'::text]))))
constraint activity_log.activity_log_label_content_only: CHECK (((label IS NULL) OR ((entity_type IS NOT NULL) AND (entity_type <> ALL (ARRAY['users'::text, 'authors'::text, 'colleagues'::text])) AND (action <> ALL (ARRAY['login'::text, 'login_failed'::text, 'logout'::text, 'password_changed'::text, 'reset_link_issued'::text, 'temporary_password_issued'::text, 'totp_enabled'::text, 'totp_disabled'::text, 'totp_reset'::text, 'recovery_code_used'::text, 'recovery_codes_regenerated'::text, 'account_unlocked'::text, 'user_activated'::text, 'user_deactivated'::text, 'roles_changed'::text, 'grants_changed'::text])))))
constraint activity_log.activity_log_pkey: PRIMARY KEY (id)
constraint activity_log.activity_log_revision_shape: CHECK (((revision_id IS NULL) OR (entity_id IS NOT NULL)))
index activity_log.activity_log_actor_id_occurred_at_idx: CREATE INDEX activity_log_actor_id_occurred_at_idx ON public.activity_log USING btree (actor_id, occurred_at DESC)
index activity_log.activity_log_entity_type_entity_id_occurred_at_idx: CREATE INDEX activity_log_entity_type_entity_id_occurred_at_idx ON public.activity_log USING btree (entity_type, entity_id, occurred_at DESC)
index activity_log.activity_log_occurred_at_idx: CREATE INDEX activity_log_occurred_at_idx ON public.activity_log USING btree (occurred_at DESC)
index activity_log.activity_log_pkey: CREATE UNIQUE INDEX activity_log_pkey ON public.activity_log USING btree (id)
trigger activity_log.activity_log_check_update_row: CREATE TRIGGER activity_log_check_update_row BEFORE UPDATE ON public.activity_log FOR EACH ROW EXECUTE FUNCTION activity_log_check_update()
trigger activity_log.activity_log_check_update_statement: CREATE TRIGGER activity_log_check_update_statement BEFORE UPDATE ON public.activity_log FOR EACH STATEMENT EXECUTE FUNCTION activity_log_check_update()
trigger activity_log.activity_log_refuse_delete: CREATE TRIGGER activity_log_refuse_delete BEFORE DELETE ON public.activity_log FOR EACH STATEMENT EXECUTE FUNCTION activity_log_refuse()
trigger activity_log.activity_log_refuse_truncate: CREATE TRIGGER activity_log_refuse_truncate BEFORE TRUNCATE ON public.activity_log FOR EACH STATEMENT EXECUTE FUNCTION activity_log_refuse()

table users
column users.created_at: timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP
column users.updated_at: timestamp with time zone NOT NULL DEFAULT CURRENT_TIMESTAMP
column users.id: bigint NOT NULL GENERATED BY DEFAULT AS IDENTITY
column users.pid: uuid NOT NULL
column users.email: text
column users.name: text NOT NULL
column users.password_hash: text
column users.must_change_password: boolean NOT NULL DEFAULT false
column users.temp_password_expires_at: timestamp with time zone
column users.token_version: integer NOT NULL DEFAULT 0
column users.active: boolean NOT NULL DEFAULT true
column users.last_login_at: timestamp with time zone
column users.totp_secret_encrypted: bytea
column users.totp_enabled_at: timestamp with time zone
column users.totp_last_step: bigint
column users.anonymised_at: timestamp with time zone
column users.created_by: bigint
column users.updated_by: bigint
column users.deleted_at: timestamp with time zone
column users.deleted_by: bigint
constraint users.users_anonymised_shape: CHECK (((anonymised_at IS NULL) OR ((email IS NULL) AND (password_hash IS NULL) AND (totp_secret_encrypted IS NULL) AND (NOT active) AND (deleted_at IS NOT NULL))))
constraint users.users_created_by_fkey: FOREIGN KEY (created_by) REFERENCES users(id) ON DELETE RESTRICT
constraint users.users_deleted_by_fkey: FOREIGN KEY (deleted_by) REFERENCES users(id) ON DELETE RESTRICT
constraint users.users_email_present: CHECK (((email IS NOT NULL) OR (anonymised_at IS NOT NULL)))
constraint users.users_pid_key: UNIQUE (pid)
constraint users.users_pkey: PRIMARY KEY (id)
constraint users.users_updated_by_fkey: FOREIGN KEY (updated_by) REFERENCES users(id) ON DELETE RESTRICT
index users.users_created_by_idx: CREATE INDEX users_created_by_idx ON public.users USING btree (created_by)
index users.users_deleted_by_idx: CREATE INDEX users_deleted_by_idx ON public.users USING btree (deleted_by)
index users.users_lower_email_key: CREATE UNIQUE INDEX users_lower_email_key ON public.users USING btree (lower(email))
index users.users_pid_key: CREATE UNIQUE INDEX users_pid_key ON public.users USING btree (pid)
index users.users_pkey: CREATE UNIQUE INDEX users_pkey ON public.users USING btree (id)
index users.users_updated_by_idx: CREATE INDEX users_updated_by_idx ON public.users USING btree (updated_by)

function activity_log_check_update(): CREATE OR REPLACE FUNCTION public.activity_log_check_update()
    |  RETURNS trigger
    |  LANGUAGE plpgsql
    | AS $function$
    | DECLARE
    |     expected record;
    | BEGIN
    |     IF current_setting('backend3.permanent_delete', true) IS DISTINCT FROM 'on' THEN
    |         RAISE EXCEPTION 'activity_log is append-only: UPDATE is allowed only in a permanent-delete transaction, which sets backend3.permanent_delete with SET LOCAL (ADR 0011 §5)'
    |             USING ERRCODE = 'restrict_violation';
    |     END IF;
    |     IF TG_LEVEL = 'STATEMENT' THEN
    |         RETURN NULL;
    |     END IF;
    |     expected := OLD;
    |     expected.ip := NULL;
    |     IF NEW *<> expected THEN
    |         RAISE EXCEPTION 'activity_log is append-only: a permanent-delete transaction may only set ip to NULL, and this UPDATE changes entry % otherwise (ADR 0011 §5)', OLD.id
    |             USING ERRCODE = 'restrict_violation';
    |     END IF;
    |     RETURN NEW;
    | END
    | $function$
function activity_log_refuse(): CREATE OR REPLACE FUNCTION public.activity_log_refuse()
    |  RETURNS trigger
    |  LANGUAGE plpgsql
    | AS $function$
    | BEGIN
    |     RAISE EXCEPTION 'activity_log is append-only: % is never allowed (ADR 0011 §5)', TG_OP
    |         USING ERRCODE = 'restrict_violation';
    | END
    | $function$
