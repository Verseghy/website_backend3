        "edit site settings",
        "edit diaktoll"
      ],
      "is_admin": true,
      "resource": "backups",
      "action": "create",
      "record": null,
      "access": [],
      "expected": false
    },
    {
      "name": "a record opens nothing on a resource without a row",
      "permissions": [
        "edit posts",
        "publish posts",
        "edit labels",
        "edit authors",
        "edit events",
        "edit canteens",
        "edit colleagues",
        "edit users",
