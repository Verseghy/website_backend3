{
  "openapi": "3.1.0",
  "info": {
    "title": "backend3 public read API",
    "description": "The public, read-only JSON API of the Verseghy Ferenc Gimnázium website.\n\nbackend3 is free software under the GNU Affero General Public License, version 3 only (AGPL-3.0-only). Its source code is published at <https://github.com/Verseghy/website_backend3>.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "1.1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "description": "The body of every error response, except `405`, which has no body.",
        "required": [
          "error",
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "English free text for humans. Clients match on `error` only."
          },
          "error": {
            "$ref": "#/components/schemas/ErrorCode",
            "description": "The error code."
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "A stable, machine-readable error code. Clients match on this value; the\n`description` next to it is free text that may change.",
        "enum": [
          "invalid_limit",
          "invalid_cursor",
          "invalid_query",
          "invalid_id",
          "invalid_date",
          "invalid_week",
          "not_found",
          "internal_server_error"
        ]
      }
    }
  }
}
